<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FocusGateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AILearnEng">

        <!-- Home screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AILearnEng">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Blocklist editor -->
        <activity
            android:name=".BlocklistActivity"
            android:exported="false"
            android:label="Edit Blocked Apps"
            android:theme="@style/Theme.AILearnEng" />

        <!-- English practice session -->
        <activity
            android:name=".PracticeActivity"
            android:exported="false"
            android:label="English Practice"
            android:theme="@style/Theme.AILearnEng" />

        <!-- App blocking overlay — runs in its own task so it covers the blocked app -->
        <activity
            android:name=".BlockOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.pe.learnai.blocker"
            android:label="FocusGate"
            android:theme="@style/Theme.AILearnEng" />

        <!-- Accessibility service that watches foreground app changes -->
        <service
            android:name=".AppBlockerService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
